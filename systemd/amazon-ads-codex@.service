[Unit]
Description=Amazon Ads Codex autonomous cycle (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=ADS_OWNER_HOME=@OWNER_HOME@
Environment=ADS_CYCLE_LOCK_WAIT_SECONDS=7200
ExecStart=/usr/bin/python3 @ROOT@/scripts/run_cycle.py %i
TimeoutStartSec=3h
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@ROOT@
ReadWritePaths=@OWNER_HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
