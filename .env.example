# Runtime overrides only. Keep real values outside Git.
# ADS_OWNER_HOME defaults to ~/.local/share/amazon-ads-codex-owner
ADS_OWNER_HOME=
ADS_CODEX_MODEL=
ADS_CODEX_TIMEOUT_SECONDS=1800
# Optional trusted ASIN contribution economics JSON; defaults to $ADS_OWNER_HOME/economics.json
ADS_ECONOMICS_FILE=
ADS_WEB_HOST=127.0.0.1
ADS_WEB_PORT=8765
# Set only when serving through a TLS reverse proxy, e.g. https://ads-control.example.com
ADS_WEB_PUBLIC_ORIGIN=
