# Runtime only. Do not commit real values.
ADS_OPERATOR_MODE=full_managed
ADS_STATE_DB=state/operator.db
ADS_CODEX_MODEL=
ADS_CODEX_TIMEOUT_SECONDS=1800
ADS_MCP_SERVER=amazon_ads
# Optional: set only if you want the controller to use an externally managed signing key.
# Otherwise scripts/bootstrap.py creates .secrets/operator_signing_key with chmod 600.
ADS_OPERATOR_SIGNING_KEY=
