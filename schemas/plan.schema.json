{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "today_spend": {"type": "number","minimum": 0},
        "today_spend_observed_at": {"type": "string","minLength": 1},
        "today_spend_evidence_ref": {"type": "string","minLength": 1},
        "active_campaign_budget_total": {"type": "number","minimum": 0},
        "observed_asins": {"type": "array","items": {"type": "string"},"uniqueItems": true}
      },
      "required": ["today_spend","today_spend_observed_at","today_spend_evidence_ref","active_campaign_budget_total","observed_asins"]
    },
    "summary": {"type": "string"},
    "actions": {
      "type": "array","maxItems": 100,
      "items": {
        "type": "object","additionalProperties": false,
        "properties": {
          "action_id": {"type": "string","minLength": 1},
          "action_type": {"type": "string","minLength": 1},
          "ad_product": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "arguments": {"type": "object"},
          "before": {"type": "object"},
          "after": {"type": "object"},
          "spend_delta": {"type": "number","minimum": 0},
          "confidence": {"type": "number","minimum": 0,"maximum": 1},
          "evidence_refs": {"type": "array","items": {"type": "string"}},
          "dependencies": {"type": "array","items": {"type": "string"}},
          "reversible": {"type": "boolean"},
          "rollback": {"oneOf": [{"type": "object"},{"type": "null"}]},
          "prewrite_observed_at": {"type": "string"},
          "rationale": {"type": "string"},
          "tool_name": {"type": "string","minLength": 1}
        },
        "required": ["action_id","action_type","tool_name","ad_product","entity_type","entity_id","arguments","before","after","spend_delta","confidence","evidence_refs","dependencies","reversible","rollback","prewrite_observed_at","rationale"]
      }
    }
  },
  "required": ["context","summary","actions"]
}
