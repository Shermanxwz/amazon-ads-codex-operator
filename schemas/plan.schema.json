{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "nullableNumber": {"oneOf": [{"type": "number"}, {"type": "null"}]},
    "learningEntity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": {"type": "string"}, "profile_id": {"type": "string", "minLength": 1}, "entity_type": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1},
        "campaign_id": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "ad_group_id": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "asin": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "query": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "match_type": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "placement": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "window_label": {"type": "string", "minLength": 1}, "window_start": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "window_end": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "impressions": {"type": "number", "minimum": 0}, "clicks": {"type": "number", "minimum": 0}, "spend": {"type": "number", "minimum": 0}, "orders": {"type": "number", "minimum": 0}, "sales": {"type": "number", "minimum": 0}, "units": {"type": "number", "minimum": 0},
        "new_to_brand_orders": {"$ref": "#/$defs/nullableNumber"}, "impression_share_pct": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]}, "impression_rank": {"oneOf": [{"type": "number", "minimum": 1}, {"type": "null"}]},
        "budget": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "bid": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "evidence_ref": {"type": "string", "minLength": 1},
        "hour_of_day": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 23}, {"type": "null"}]}, "day_of_week": {"oneOf": [{"type": "string", "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}, {"type": "null"}]},
        "bidding_strategy": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "budget_status": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "audience": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "ad_format": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "keyword_text": {"type": ["string", "null"]}, "target_type": {"type": ["string", "null"]}, "price": {"type": ["number", "null"], "minimum": 0}, "featured_offer_eligible": {"type": ["boolean", "null"]}, "in_stock": {"type": ["boolean", "null"]}, "organic_rank": {"type": ["number", "null"], "minimum": 0}, "review_count": {"type": ["number", "null"], "minimum": 0}, "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "suggested_bid": {"type": ["number", "null"], "minimum": 0}, "budget_utilization_pct": {"type": ["number", "null"], "minimum": 0}, "placement_bid_adjustment_pct": {"type": ["number", "null"], "minimum": 0}, "audience_bid_boost_pct": {"type": ["number", "null"], "minimum": 0}, "video_bid_boost_pct": {"type": ["number", "null"], "minimum": 0}
      },
      "required": ["observed_at", "profile_id", "entity_type", "entity_id", "campaign_id", "ad_group_id", "asin", "query", "match_type", "placement", "window_label", "window_start", "window_end", "impressions", "clicks", "spend", "orders", "sales", "units", "new_to_brand_orders", "impression_share_pct", "impression_rank", "budget", "bid", "evidence_ref", "hour_of_day", "day_of_week", "bidding_strategy", "budget_status", "audience", "ad_format"]
    },
    "economics": {
      "type": "object", "additionalProperties": false,
      "properties": {"asin": {"type": "string", "minLength": 1}, "observed_at": {"type": "string"}, "contribution_margin_pct": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]}, "contribution_margin_per_order": {"$ref": "#/$defs/nullableNumber"}, "unit_cogs": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "amazon_fees": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "promo_cost_per_order": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "return_rate_pct": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]}, "inventory_units": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "evidence_ref": {"type": "string", "minLength": 1}},
      "required": ["asin", "observed_at", "contribution_margin_pct", "contribution_margin_per_order", "unit_cogs", "amazon_fees", "promo_cost_per_order", "return_rate_pct", "inventory_units", "evidence_ref"]
    },
    "portfolioCandidate": {
      "type": "object", "additionalProperties": false,
      "properties": {"candidate_id": {"type": "string", "minLength": 1}, "asin": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "campaign_id": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "entity_type": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1}, "hypothesis": {"type": "string", "minLength": 1}, "expected_incremental_spend": {"type": "number", "minimum": 0}, "expected_incremental_sales": {"type": "number", "minimum": 0}, "expected_incremental_profit": {"type": "number"}, "uncertainty": {"type": "number", "minimum": 0, "maximum": 1}, "horizon_days": {"type": "integer", "minimum": 1, "maximum": 90}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "maxItems": 40}},
      "required": ["candidate_id", "asin", "campaign_id", "entity_type", "entity_id", "hypothesis", "expected_incremental_spend", "expected_incremental_sales", "expected_incremental_profit", "uncertainty", "horizon_days", "evidence_refs"]
    },
    "experiment": {
      "type": "object", "additionalProperties": false,
      "properties": {"experiment_id": {"type": "string", "minLength": 1}, "hypothesis": {"type": "string", "minLength": 1}, "action_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 20}, "entity_type": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1}, "primary_metric": {"type": "string", "enum": ["contribution_profit", "roas", "acos_pct", "cvr", "ctr", "sales", "orders"]}, "expected_direction": {"type": "string", "enum": ["increase", "decrease"]}, "baseline_window_days": {"type": "integer", "minimum": 1, "maximum": 90}, "evaluation_days": {"type": "integer", "minimum": 1, "maximum": 60}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "maxItems": 40}},
      "required": ["experiment_id", "hypothesis", "action_ids", "entity_type", "entity_id", "primary_metric", "expected_direction", "baseline_window_days", "evaluation_days", "evidence_refs"]
    }
  },
  "properties": {
    "context": {"type": "object", "additionalProperties": true, "properties": {"today_spend": {"type": "number", "minimum": 0}, "today_spend_observed_at": {"type": "string", "minLength": 1}, "today_spend_evidence_ref": {"type": "string", "minLength": 1}, "active_campaign_budget_total": {"type": "number", "minimum": 0}, "observed_asins": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "required": ["today_spend", "today_spend_observed_at", "today_spend_evidence_ref", "active_campaign_budget_total", "observed_asins"]},
    "summary": {"type": "string"},
    "learning_snapshot": {"type": "object", "additionalProperties": false, "properties": {"observed_at": {"type": "string", "minLength": 1}, "entities": {"type": "array", "items": {"$ref": "#/$defs/learningEntity"}, "maxItems": 1200}, "economics": {"type": "array", "items": {"$ref": "#/$defs/economics"}, "maxItems": 200}, "portfolio_candidates": {"type": "array", "items": {"$ref": "#/$defs/portfolioCandidate"}, "maxItems": 200}, "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}, "maxItems": 100}}, "required": ["observed_at", "entities", "economics", "portfolio_candidates", "experiments"]},
    "actions": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "properties": {"action_id": {"type": "string", "minLength": 1}, "action_type": {"type": "string", "minLength": 1}, "ad_product": {"type": "string"}, "entity_type": {"type": "string"}, "entity_id": {"type": "string"}, "arguments": {"type": "object"}, "before": {"type": "object"}, "after": {"type": "object"}, "spend_delta": {"type": "number", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "dependencies": {"type": "array", "items": {"type": "string"}}, "reversible": {"type": "boolean"}, "rollback": {"oneOf": [{"type": "object"}, {"type": "null"}]}, "prewrite_observed_at": {"type": "string"}, "rationale": {"type": "string"}, "tool_name": {"type": "string", "minLength": 1}}, "required": ["action_id", "action_type", "tool_name", "ad_product", "entity_type", "entity_id", "arguments", "before", "after", "spend_delta", "confidence", "evidence_refs", "dependencies", "reversible", "rollback", "prewrite_observed_at", "rationale"]}}
  },
  "required": ["context", "summary", "learning_snapshot", "actions"]
}
